{
  "name": "noise-cancel-extension",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "copy-dtln": "node scripts/copy-dtln-assets.mjs",
    "copy-engine": "node scripts/copy-engine-assets.mjs",
    "copy-assets": "npm run copy-dtln && npm run copy-engine",
    "dev": "npm run copy-assets && vite build --watch",
    "build": "npm run copy-assets && vite build",
    "test": "node --test src/audio/call-audio-constraints.test.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@jitsi/rnnoise-wasm": "^0.2.1",
    "@workadventure/noise-suppression": "^0.1.1",
    "deepfilternet3-noise-filter": "^1.3.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "eslint": "^9.9.0",
    "prettier": "^3.3.3"
  }
}
