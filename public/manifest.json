{
  "manifest_version": 3,
  "name": "Agent Noise Cancellation",
  "description": "Bidirectional DeepFilterNet3 + Jitsi RNNoise cancellation for browser calls.",
  "version": "0.2.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Agent Noise Cancellation"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "audioCapture", "microphone", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["page-bridge-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js", "dtln/*", "engine/*", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
